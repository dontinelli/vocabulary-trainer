# Copy this file to .env for local development. Never put production credentials here.
NEXTCLOUD_PORT=8080
NEXTCLOUD_IMAGE=nextcloud:stable-apache
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=admin-dev
MYSQL_DATABASE=nextcloud
MYSQL_USER=nextcloud
MYSQL_PASSWORD=nextcloud-dev
MYSQL_ROOT_PASSWORD=root-dev
